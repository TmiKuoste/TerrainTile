<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<LangVersion>9.0</LangVersion>
		<Nullable>enable</Nullable>
		<RootNamespace>Kuoste.TerrainEngine.Common</RootNamespace>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>TerrainEngine.Common</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="LasUtility" Version="0.9.3" />
	  <PackageReference Include="NetTopologySuite" Version="2.6.0" />
	</ItemGroup>

	<!-- Vendor the built DLL into the Unity package on Release builds (path relative to this project). -->
	<Target Name="VendorDllToUnity" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<Copy SourceFiles="$(TargetPath)" DestinationFolder="../../fi.kuoste.terraintile/Runtime/dll/" SkipUnchangedFiles="true" />
	</Target>

</Project>
